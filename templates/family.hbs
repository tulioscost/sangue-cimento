<section class="sc-root"><header class="sc-filehead"><div><div class="sc-kicker">DOSSIÊ ORGANIZACIONAL · FAMÍLIA SOB OBSERVAÇÃO</div><h1>REGISTRO DA FAMÍLIA</h1><p>Recursos, hierarquia, contratos e dívidas</p></div><div class="sc-stamp">CONFIDENCIAL</div></header>
<div class="sc-identification"><button type="button" class="sc-portrait" data-action="editPortrait"><img src="{{actor.img}}" alt="Brasão"><span>BRASÃO</span></button><div class="sc-id-fields"><label>NOME DA ORGANIZAÇÃO<input name="name" value="{{actor.name}}"></label><div class="sc-two"><label>ORIGEM<input name="system.identity.origem" value="{{system.identity.origem}}"></label><label>FACHADA<input name="system.identity.fachada" value="{{system.identity.fachada}}"></label></div><label>NEGÓCIO<input name="system.identity.negocio" value="{{system.identity.negocio}}"></label></div></div>
<div class="sc-tracks"><div class="sc-track">COESÃO <b>{{system.coesao.value}}/{{system.coesao.max}}</b></div><div class="sc-track">FISSURA <b>{{system.fissura.value}}/{{system.fissura.max}}</b></div><div class="sc-track">EXPOSIÇÃO <b>{{system.exposicao.value}}/{{system.exposicao.max}}</b></div></div>
<div class="sc-paper-content"><h2>I · Recursos da Família</h2><div class="sc-resources">{{#each resources as |r|}}<div class="sc-resource"><label>{{r.label}}<input name="system.recursos.{{r.key}}" type="number" min="0" max="10" value="{{r.value}}"></label><button type="button" data-action="rollFamily" data-resource="{{r.key}}">TESTAR</button></div>{{/each}}</div><div class="sc-control-strip"><label>DIFICULDADE <input data-sc-difficulty type="number" value="2" min="1" max="5"></label><label>COMPETÊNCIA (ATÉ 2) <input data-sc-competence type="number" value="1" min="0" max="2"></label><label>PREPARAÇÃO (ATÉ 1) <input data-sc-preparation type="number" value="0" min="0" max="1"></label><label>MODIF. <input data-sc-bonus type="number" value="0" min="-10" max="10"></label></div><small>Teto de Ações de Família: 9d6 · teste D2 por padrão</small>
<h2>II · Pacto e condições</h2><div class="sc-two"><label>ANTIGO PATRONO<input name="system.identity.antigo" value="{{system.identity.antigo}}"></label><label>DOM FAMILIAR<input name="system.identity.domFamiliar" value="{{system.identity.domFamiliar}}"></label><label>TRIBUTO<textarea name="system.identity.tributo" rows="2">{{system.identity.tributo}}</textarea></label><label>TABU<textarea name="system.identity.tabu" rows="2">{{system.identity.tabu}}</textarea></label></div><label>CONTRATO ANCESTRAL<textarea rows="3" name="system.identity.contrato">{{system.identity.contrato}}</textarea></label><label>CLÁUSULA OCULTA<textarea rows="2" name="system.identity.clausulaOculta">{{system.identity.clausulaOculta}}</textarea></label><h2>III · Organização</h2><div class="sc-two"><label>REGRA<input name="system.identity.regra" value="{{system.identity.regra}}"></label><label>DOMÍNIO<input name="system.identity.dominio" value="{{system.identity.dominio}}"></label><label>GRANDE SEGREDO<textarea name="system.identity.segredoMaior">{{system.identity.segredoMaior}}</textarea></label><label>INIMIGO<textarea name="system.identity.inimigo">{{system.identity.inimigo}}</textarea></label></div><label>REGISTRO DE OPERAÇÕES<textarea name="system.anotacoes" rows="3">{{system.anotacoes}}</textarea></label></div><footer class="sc-footer">ARQUIVO DE FAMÍLIAS DE VÉSPERA • RESTRITO</footer></section>
