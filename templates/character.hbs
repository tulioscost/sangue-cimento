<section class="sc-root sc-character">
<header class="sc-filehead"><div><div class="sc-kicker">DEPARTAMENTO ESPECIAL DE VÉSPERA · DOCUMENTO CONFIDENCIAL</div><h1>SANGUE <i>&</i> CIMENTO</h1><p>Registro criminal • vínculo ancestral • observações ritualísticas</p></div><div class="sc-stamp">RESTRITO<br><small>ARQUIVO 0317</small></div></header>
<div class="sc-identification">
  <button type="button" class="sc-portrait" data-action="editPortrait" title="Selecionar retrato"><img src="{{actor.img}}" alt="Retrato"><span>ALTERAR FOTOGRAFIA</span></button>
  <div class="sc-id-fields">
    <label>IDENTIFICAÇÃO <input name="name" value="{{actor.name}}"></label>
    <div class="sc-two"><label>ALCUNHA <input name="system.identidade.apelido" value="{{system.identidade.apelido}}"></label><label>FAMÍLIA <input name="system.identidade.familia" value="{{system.identidade.familia}}"></label></div>
    <div class="sc-two"><label>POSIÇÃO <input name="system.identidade.cargo" value="{{system.identidade.cargo}}"></label><label>ARQUÉTIPO <input name="system.identidade.arquetipo" value="{{system.identidade.arquetipo}}"></label></div>
    <div class="sc-two"><label>ANTIGO PATRONO <input name="system.identidade.antigo" value="{{system.identidade.antigo}}"></label><label>VÍNCULO <input type="number" min="0" max="4" name="system.identidade.vinculo" value="{{system.identidade.vinculo}}"></label></div>
  </div>
  <div class="sc-seal">SC<br><small>ANÔMALO</small></div>
</div>
<div class="sc-tracks">
  {{#each system.resources as |v k|}}<div class="sc-track"><span>{{k}}</span><button type="button" data-action="adjustTrack" data-track="{{k}}" data-delta="-1">−</button><strong>{{v.value}} / {{v.max}}</strong><button type="button" data-action="adjustTrack" data-track="{{k}}" data-delta="1">+</button></div>{{/each}}
  <div class="sc-track"><span>RD</span><input type="number" name="system.armadura" value="{{system.armadura}}" min="0"></div>
</div>
<nav class="sc-tab-bar" aria-label="Seções da ficha"><button type="button" class="is-active" data-tab-target="dossie">▣ DOSSIÊ</button><button type="button" data-tab-target="pericias">◇ PERÍCIAS</button><button type="button" data-tab-target="grimorio">☿ GRIMÓRIO</button><button type="button" data-tab-target="arsenal">⚔ ARSENAL</button><button type="button" data-tab-target="lacos">✦ LAÇOS</button><button type="button" data-tab-target="facsimile">▤ REFERÊNCIA</button></nav>
<section class="sc-control-strip"><label>DIFICULDADE <input type="number" min="1" max="5" value="2" data-sc-difficulty></label><label>MODIFICADOR <input type="number" min="-10" max="10" value="0" data-sc-bonus></label><small>5–6 = sucesso · 6 = Ímpeto (em êxito) · teto 10d6</small></section>
<div class="sc-paper-content">
<div class="sc-pane is-active" data-sc-pane="dossie"><h2>I · Perfil e atributos</h2><div class="sc-attributes">
{{#each attributes as |a|}}<div class="sc-attribute"><label>{{a.label}}</label><input type="number" name="system.attributes.{{a.key}}.value" min="0" max="10" value="{{a.value}}"><button type="button" data-action="rollAttribute" data-attribute="{{a.key}}" title="Rolar {{a.label}}">🎲</button></div>{{/each}}
</div><h2>II · Anotações no inquérito</h2><textarea name="system.ficha.notas" rows="5" placeholder="Interrogatórios, pistas e depoimentos...">{{system.ficha.notas}}</textarea><h2>III · Registro de investigação</h2><textarea name="system.ficha.investigacoes" rows="3">{{system.ficha.investigacoes}}</textarea></div>
<div class="sc-pane sc-pane-skills" data-sc-pane="pericias"><h2>Qualificações do investigado</h2><div class="sc-skills-groups">{{#each skillGroups as |group|}}<section class="sc-skill-group"><header>{{group.label}}</header><div class="sc-skills-list">{{#each group.skills as |s|}}<div class="sc-skill"><span>{{s.label}}</span><input name="system.skills.{{s.key}}.value" type="number" min="0" max="10" value="{{s.value}}"><button type="button" data-action="rollSkill" data-skill="{{s.key}}">TESTAR</button></div>{{/each}}</div></section>{{/each}}</div></div>
<div class="sc-pane" data-sc-pane="grimorio"><h2>Contrato ancestral · dons · projetos</h2><div class="sc-two"><label>CORRUPÇÃO — MARCAS E SINAIS<textarea rows="3" name="system.ficha.marcas">{{system.ficha.marcas}}</textarea></label><label>SEGREDO PROIBIDO<textarea rows="3" name="system.ficha.segredo">{{system.ficha.segredo}}</textarea></label></div><div class="sc-toolbar"><button type="button" data-action="addItem" data-item-type="dom">+ REGISTRAR DOM</button><button type="button" data-action="addItem" data-item-type="ritual">+ PROJETO RITUAL</button></div>
{{#each doms as |item|}}<article class="sc-record"><div><b>DOM · {{item.name}}</b><small>{{item.system.categoria}} • Potência {{item.system.nivel}} • {{item.system.frequencia}}</small></div><button type="button" data-action="editItem" data-item-id="{{item.id}}">EDITAR</button><button type="button" data-action="deleteItem" data-item-id="{{item.id}}">×</button></article>{{/each}}
{{#each rituais as |item|}}<article class="sc-record sc-ritual"><div><b>RITUAL · {{item.name}}</b><small>D{{item.system.dificuldade}} • Etapa: {{item.system.etapa}}</small><div class="sc-clocks"><span>PROGRESSO {{item.system.progresso.value}}/{{item.system.progresso.max}}</span><button type="button" data-action="changeRitual" data-pool="progresso" data-delta="-1" data-item-id="{{item.id}}">−</button><button type="button" data-action="changeRitual" data-pool="progresso" data-delta="1" data-item-id="{{item.id}}">+</button><span>PERIGO {{item.system.perigo.value}}/{{item.system.perigo.max}}</span><button type="button" data-action="changeRitual" data-pool="perigo" data-delta="-1" data-item-id="{{item.id}}">−</button><button type="button" data-action="changeRitual" data-pool="perigo" data-delta="1" data-item-id="{{item.id}}">+</button></div></div><button type="button" data-action="editItem" data-item-id="{{item.id}}">EDITAR</button><button type="button" data-action="deleteItem" data-item-id="{{item.id}}">×</button></article>{{/each}}
</div>
<div class="sc-pane" data-sc-pane="arsenal"><h2>Inventário apreendido</h2><div class="sc-toolbar"><button type="button" data-action="addItem" data-item-type="arma">+ ARMA</button><button type="button" data-action="addItem" data-item-type="armadura">+ PROTEÇÃO</button><button type="button" data-action="addItem" data-item-type="equipamento">+ EQUIPAMENTO</button></div>{{#each arsenal as |item|}}<article class="sc-record"><div><b>{{item.name}}</b><small>{{item.type}} · dano {{item.system.dano}} · RD {{item.system.rd}}</small></div><button type="button" data-action="editItem" data-item-id="{{item.id}}">EDITAR</button><button type="button" data-action="deleteItem" data-item-id="{{item.id}}">×</button></article>{{/each}}</div>
<div class="sc-pane" data-sc-pane="lacos"><h2>Confissão e relações</h2><div class="sc-two"><label>DÍVIDA<textarea name="system.ficha.divida" rows="3">{{system.ficha.divida}}</textarea></label><label>AMBIÇÃO<textarea name="system.ficha.ambicao" rows="3">{{system.ficha.ambicao}}</textarea></label><label>LAÇO<textarea name="system.ficha.laco" rows="3">{{system.ficha.laco}}</textarea></label><label>PECADO<textarea name="system.ficha.pecado" rows="3">{{system.ficha.pecado}}</textarea></label></div><div class="sc-toolbar"><button type="button" data-action="addItem" data-item-type="favor">+ FAVOR</button><button type="button" data-action="addItem" data-item-type="contato">+ CONTATO</button></div>{{#each contatos as |item|}}<article class="sc-record"><b>{{item.name}}</b><button type="button" data-action="editItem" data-item-id="{{item.id}}">EDITAR</button><button type="button" data-action="deleteItem" data-item-id="{{item.id}}">×</button></article>{{/each}}</div>
<div class="sc-pane" data-sc-pane="facsimile"><h2>Fac-símile · referência artística da ficha</h2><p class="sc-muted">A aba documental reproduz a arte solicitada; as demais abas contêm todos os campos realmente editáveis.</p><img class="sc-facsimile" src="systems/sangue-cimento/assets/illustrations/ficha-referencia.webp" alt="Ficha policial e grimório"></div>
</div><footer class="sc-footer">APENAS PESSOAL AUTORIZADO · PROTOCOLO ANCESTRAL 0317 · VÉSPERA</footer>
</section>
