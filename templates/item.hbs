<section class="sc-root"><header class="sc-filehead"><div><div class="sc-kicker">APÊNDICE AO DOSSIÊ · EVIDÊNCIA / CLÁUSULA</div><h1>REGISTRO DE {{item.type}}</h1></div><div class="sc-stamp">INDEXADO</div></header><div class="sc-identification"><button type="button" data-action="editPortrait" class="sc-portrait"><img src="{{item.img}}"><span>IMAGEM</span></button><div class="sc-id-fields"><label>NOME DO REGISTRO<input name="name" value="{{item.name}}"></label><label>CONCEITO<input name="system.conceito" value="{{system.conceito}}"></label><label>PREÇO<input name="system.preco" value="{{system.preco}}"></label><label>TABU<input name="system.tabu" value="{{system.tabu}}"></label></div></div><div class="sc-paper-content"><h2>Detalhamento do objeto</h2>
{{#if isDom}}<div class="sc-two"><label>POTÊNCIA <input type="number" min="1" max="5" name="system.nivel" value="{{system.nivel}}"></label><label>CATEGORIA<input name="system.categoria" value="{{system.categoria}}"></label><label>ALCANCE<input name="system.alcance" value="{{system.alcance}}"></label><label>DURAÇÃO<input name="system.duracao" value="{{system.duracao}}"></label><label>FREQUÊNCIA<input name="system.frequencia" value="{{system.frequencia}}"></label><label>RESISTÊNCIA<input name="system.resistencia" value="{{system.resistencia}}"></label><label>CONTRAMEDIDA<input name="system.contramedida" value="{{system.contramedida}}"></label><label>CORRUPÇÃO<input type="number" min="0" max="5" name="system.custoCorrupcao" value="{{system.custoCorrupcao}}"></label></div>{{/if}}
{{#if isRitual}}<div class="sc-two"><label>DIFICULDADE<input type="number" min="1" max="5" name="system.dificuldade" value="{{system.dificuldade}}"></label><label>ETAPA<input name="system.etapa" value="{{system.etapa}}"></label><label>PROGRESSO ATUAL<input type="number" min="0" max="6" name="system.progresso.value" value="{{system.progresso.value}}"></label><label>PROGRESSO TOTAL (4/6)<input type="number" min="4" max="6" name="system.progresso.max" value="{{system.progresso.max}}"></label><label>PERIGO ATUAL<input type="number" min="0" max="6" name="system.perigo.value" value="{{system.perigo.value}}"></label><label>PERIGO TOTAL (4/6)<input type="number" min="4" max="6" name="system.perigo.max" value="{{system.perigo.max}}"></label><label>REQUISITOS<textarea name="system.requisitos" rows="2">{{system.requisitos}}</textarea></label><label>INVOCAÇÃO<textarea name="system.invocacao" rows="2">{{system.invocacao}}</textarea></label></div>{{/if}}
{{#if isGear}}<div class="sc-two"><label>DANO<input type="number" name="system.dano" value="{{system.dano}}"></label><label>REDUÇÃO DE DANO<input type="number" name="system.rd" value="{{system.rd}}"></label><label>CARGA<input type="number" name="system.carga" value="{{system.carga}}"></label><label>DURABILIDADE<input type="number" name="system.durabilidade" value="{{system.durabilidade}}"></label></div>{{/if}}
{{#if isContact}}<div class="sc-two"><label>LEALDADE<input type="number" min="-2" max="2" name="system.lealdade" value="{{system.lealdade}}"></label><label>FAVOR<input type="number" name="system.favor" value="{{system.favor}}"></label></div>{{/if}}
<label>EFEITOS, REGRA OU DESCRIÇÃO<textarea name="system.descricao" rows="5">{{system.descricao}}</textarea></label><label>OBSERVAÇÕES<textarea name="system.notas" rows="4">{{system.notas}}</textarea></label></div><footer class="sc-footer">PROTOCOLO DE EVIDÊNCIA 0317</footer></section>
