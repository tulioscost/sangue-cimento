<section class="sc-root"><header class="sc-filehead"><div><div class="sc-kicker">CATÁLOGO DE ENTIDADES · ACESSO NEGADO</div><h1>O REGISTRO DOS ANTIGOS</h1><p>Desejo · regra · preço · manifestação</p></div><div class="sc-stamp">NÃO OLHE</div></header>
<div class="sc-identification"><button type="button" class="sc-portrait" data-action="editPortrait"><img src="{{actor.img}}"><span>RETRATO</span></button><div class="sc-id-fields"><label>DENOMINAÇÃO<input name="name" value="{{actor.name}}"></label><label>GRAU DE PRESENÇA <input type="number" min="1" max="5" name="system.grau" value="{{system.grau}}"></label><label>DOMÍNIO PRINCIPAL<input name="system.dominioPrincipal" value="{{system.dominioPrincipal}}"></label><label>DOMÍNIO SECUNDÁRIO<input name="system.dominioSecundario" value="{{system.dominioSecundario}}"></label></div></div>
<div class="sc-paper-content"><h2>Sete cláusulas da manifestação</h2><div class="sc-two"><label>DESEJO<textarea name="system.desejo" rows="3">{{system.desejo}}</textarea></label><label>RESTRIÇÃO<textarea name="system.restricao" rows="3">{{system.restricao}}</textarea></label><label>TRIBUTO<textarea name="system.tributo" rows="3">{{system.tributo}}</textarea></label><label>TABU<textarea name="system.tabu" rows="3">{{system.tabu}}</textarea></label><label>MANIFESTAÇÃO<textarea name="system.manifestacao" rows="3">{{system.manifestacao}}</textarea></label><label>COBRANÇA<textarea name="system.cobranca" rows="3">{{system.cobranca}}</textarea></label></div><label>DESCRIÇÃO COSMOLÓGICA<textarea rows="3" name="system.descricao">{{system.descricao}}</textarea></label><label>ANOTAÇÕES PROIBIDAS<textarea rows="3" name="system.anotacoes">{{system.anotacoes}}</textarea></label></div><footer class="sc-footer">UMA ENTIDADE NÃO É UM ADVERSÁRIO DE COMBATE COMUM</footer></section>
